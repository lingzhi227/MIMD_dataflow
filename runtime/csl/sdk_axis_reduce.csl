// Asynchronous half-vector allreduce over independent SDK X/Y resource sets.
// Local storage is f16; transport/accumulation is f32; output narrows once.
// Caller owns source/destination until f_callback. In-place half I/O is allowed
// because all source words are widened before the asynchronous operation starts.
param c2d_params;
param capacity: u16;
param f_callback: fn()void;
param callback_task_id: local_task_id = @get_local_task_id(10);
comptime { @comptime_assert(capacity > 0); }
const mx = @import_module("<collectives_2d/pe>", .{ .dim_params=c2d_params.x });
const my = @import_module("<collectives_2d/pe>", .{ .dim_params=c2d_params.y });
var send = @zeros([capacity]f32);
var reduced = @zeros([capacity]f32);
const dummy = @zeros([1]f16);
const half_view = @get_dsd(mem1d_dsd, .{ .base_address=&dummy, .extent=capacity });
const send_view = @get_dsd(mem1d_dsd, .{ .base_address=&send, .extent=capacity });
const reduced_view = @get_dsd(mem1d_dsd, .{ .base_address=&reduced, .extent=capacity });
var axis: u16 = 0;
var count: u16 = 0;
var phase: u16 = 0;
var busy: bool = false;
var destination: [*]f16;

fn widen(value: f16) f32 { return @as(f32,value); }
fn narrow(value: f32) f16 { return @as(f16,value); }
fn init() void { mx.init(); my.init(); }

fn start(selected_axis: u16, source: [*]f16, output: [*]f16, length: u16) void {
    @assert(!busy and selected_axis<=1 and length>0 and length<=capacity);
    busy=true; axis=selected_axis; count=length; destination=output; phase=0;
    const input=@set_dsd_length(@set_dsd_base_addr(half_view,source),count);
    const widened=@set_dsd_length(send_view,count);
    @map(widen,input,widened);
    if (axis==0) { mx.reduce_fadds(0,&send,&reduced,count,callback_task_id); }
    else { my.reduce_fadds(0,&send,&reduced,count,callback_task_id); }
}

task advance() void {
    @assert(busy);
    if (phase==0) {
        phase=1;
        if (axis==0) {
            mx.broadcast(0,@ptrcast([*]u32,&reduced),count,callback_task_id);
        } else {
            my.broadcast(0,@ptrcast([*]u32,&reduced),count,callback_task_id);
        }
    } else {
        @assert(phase==1);
        const values=@set_dsd_length(reduced_view,count);
        const output=@set_dsd_length(@set_dsd_base_addr(half_view,destination),count);
        @map(narrow,values,output);
        busy=false;
        f_callback();
    }
}
comptime { @bind_local_task(advance,callback_task_id); }
