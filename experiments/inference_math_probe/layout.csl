param N:u16;
const memcpy=@import_module("<memcpy/get_params>",.{.width=1,.height=1});
layout {
 @set_rectangle(1,1);
 @set_tile_code(0,0,"pe.csl",.{.N=@as(i16,N),.memcpy_params=memcpy.get_params(0)});
 @export_name("x",[*]f16,true);
 @export_name("sdk_exp",[*]f16,true);
 @export_name("source_exp",[*]f16,true);
 @export_name("sdk_sqrt",[*]f16,true);
 @export_name("progress",[*]u16,true);
 @export_name("main",fn()void);
}
