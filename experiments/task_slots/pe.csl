param memcpy_params;
param slot: u16;
const sys = @import_module("<memcpy/memcpy>", memcpy_params);
const ENTRY = @get_local_task_id(slot);
var result = [1]f32{0.0};
var ptr: [*]f32 = &result;
fn main() void { @activate(ENTRY); }
task increment() void { result[0] += 1.0; sys.unblock_cmd_stream(); }
comptime { @bind_local_task(increment, ENTRY); @export_symbol(main); @export_symbol(ptr, "result"); }
