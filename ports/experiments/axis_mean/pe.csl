param memcpy_params;param c2d_params;param Nt:i16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const time=@import_module("<time>");
const pos=@import_module("<layout>");const config=@import_module("<tile_config>");
const collective=@import_module("sdk_axis_reduce.csl",.{.c2d_params=c2d_params,.capacity=4,.f_callback=after_reduce});
const mean_op=@import_module("sdk_axis_mean.csl",.{.capacity=4,.f_reduce=reduce,.f_broadcast=broadcast,.f_callback=after_reduce});
const rms_sum=@import_module("batched_rms_local.csl",.{.batches=3,.features=Nt,.global_features=256,.epsilon=0.000001});
const rms_mean=@import_module("batched_rms_local.csl",.{.batches=3,.features=Nt,.global_features=256,.epsilon=0.000001,.statistic_is_mean=true});
fn reduce(axis:u16,input:[*]f32,output:[*]f32,count:u16,callback:local_task_id) void {
 @assert(!collective.busy);
 if(axis==0){collective.mx.reduce_fadds(0,input,output,count,callback);}else{collective.my.reduce_fadds(0,input,output,count,callback);}
}
fn broadcast(axis:u16,data:[*]u32,count:u16,callback:local_task_id) void {
 @assert(!collective.busy);
 if(axis==0){collective.mx.broadcast(0,data,count,callback);}else{collective.my.broadcast(0,data,count,callback);}
}
var Z=@zeros([3*Nt]f16);var scratch=@zeros([3*Nt]f16);
var gamma=@zeros([Nt]f16);
var local_stats=@zeros([6]f16);var sum_box=@zeros([6]f16);var mean_box=@zeros([6]f16);var after_box=@zeros([6]f16);
var normalized=@zeros([3*Nt]f16);var legacy_normalized=@zeros([3*Nt]f16);
var progress=@zeros([1]u16);var callbacks=@zeros([1]u16);var legacy_valid=@zeros([1]u16);
var queues=@zeros([2]u16);var skew=@zeros([1]u16);
var timing=@zeros([18]u16);var started=@zeros([3]u16);var finished=@zeros([3]u16);
fn mark_start() void {time.get_timestamp(&started);}
fn mark_finish() void {time.get_timestamp(&finished);for(@range(u16,3))|i|{timing[6*phase+i]=started[i];timing[6*phase+i+3]=finished[i];}}
var phase:u16=0;var axis:u16=0;var count:u16=0;var divisor:u16=0;
const divisors=[8]u16{256,256,1,256,128,256,512,256};
fn delay() void {
 const n:u16=1+(@as(u16,pos.get_x_coord())+3*@as(u16,pos.get_y_coord())+progress[0]+phase)%17;
 for(@range(u16,n)) |i| {skew[0]+=i+1;}
}
fn init_task() void {collective.init();for(@range(i16,Nt))|i|{gamma[i]=1.0;}sys.unblock_cmd_stream();}
fn hls_main() void {
 @assert(!collective.busy and !mean_op.busy and progress[0]<8);
 time.enable_tsc();phase=0;axis=progress[0]%2;count=if(axis==0) 3 else 4;divisor=divisors[progress[0]];
 for(@range(u16,6)) |i| {local_stats[i]=0.0;sum_box[i]=-13.0;mean_box[i]=-13.0;after_box[i]=-23.0;}
 local_stats[0]=17.0;local_stats[5]=-19.0;
 rms_sum.square_sum(&Z,&scratch,@ptrcast([*]f16,&local_stats[1]));
 delay();mark_start();collective.start(axis,@ptrcast([*]f16,&local_stats[1]),@ptrcast([*]f16,&sum_box[1]),count);
}
fn after_reduce() void {
 mark_finish();
 @assert(!collective.busy and !mean_op.busy);callbacks[0]+=1;
 if(phase==0){
  if(progress[0]<2){legacy_valid[0]=0;for(@range(i16,3*Nt))|i|{legacy_normalized[i]=0.0;}}
  else{legacy_valid[0]=1;rms_sum.normalize(&Z,&gamma,&legacy_normalized,@ptrcast([*]f16,&sum_box[1]));}
  for(@range(u16,count))|i|{mean_box[i+1]=local_stats[i+1];}
  phase=1;delay();mark_start();mean_op.start(axis,@ptrcast([*]f16,&mean_box[1]),@ptrcast([*]f16,&mean_box[1]),count,divisor);
 }else if(phase==1){
  rms_mean.normalize(&Z,&gamma,&normalized,@ptrcast([*]f16,&mean_box[1]));
  phase=2;delay();mark_start();collective.start(1-axis,@ptrcast([*]f16,&local_stats[1]),@ptrcast([*]f16,&after_box[1]),if(count==3) 4 else 3);
 }else{
  @assert(phase==2);time.disable_tsc();progress[0]+=1;
  const iq=config.input_queue_status.get();const oq=config.output_queue_status.get();
  queues[0]=@as(u16,iq.empty);queues[1]=@as(u16,oq.empty);
  sys.unblock_cmd_stream();
 }
}
