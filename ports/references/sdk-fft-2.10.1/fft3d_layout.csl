// 3D FFT has same width and height
param width: i16;
param memcpy: imported_module;

const fft = @import_module("<kernels/fft/get_params>", .{
  .width = width,
});

fn FFT_row(py_start: i16, py_end: i16, width: u16, n: u16, tensor_type: type) void {
  //first PE
  const firstMemcpyParams = memcpy.get_params(0);
  const firstFftParams = fft.get_params(0, py_start, tensor_type);

  const source = "<kernels/fft/fft3d_rpc>";

  for (@range(u16,py_start, py_end, 1)) |Py| {
    @set_tile_code(0, Py, source, .{
      .fft_params = firstFftParams,
      .memcpy_params = firstMemcpyParams,
      .N = n,
    });
  }

  if (width > 2) {
    //second PE
    const secondMemcpyParams = memcpy.get_params(1);
    const secondFftParams = fft.get_params(1, py_start, tensor_type);
    for (@range(u16,py_start, py_end, 1)) |Py| {
      @set_tile_code(1, Py, source, .{
        .fft_params = secondFftParams,
        .memcpy_params = secondMemcpyParams,
        .N = n,
      });
    }

    if (width > 4) {
      //other PEs
      const otherFftParams = fft.get_params(2, py_start, tensor_type);
      const otherParams = .{
        .fft_params = otherFftParams,
        .memcpy_params = secondMemcpyParams,
        .N = n,
      };
      for (@range(u16,py_start, py_end, 1)) |Py| {
        for (@range(u16,2, width-2, 1)) |Px| {
          @set_tile_code(Px, Py, source, otherParams);
        }
      }
    }

    if (width > 3) {
      //second to last PE
      const secondToLastFftParams = fft.get_params(width - 2, py_start, tensor_type);
      for (@range(u16,py_start, py_end, 1)) |Py| {
        @set_tile_code(width - 2, Py, source, .{
          .fft_params = secondToLastFftParams,
          .memcpy_params = secondMemcpyParams,
          .N = n,
        });
      }
    }
  }

  //last PE
  const lastMemcpyParams = memcpy.get_params(width - 1);
  const lastFftParams = fft.get_params(width - 1, py_start, tensor_type);
  for (@range(u16,py_start, py_end, 1)) |Py| {
    @set_tile_code(width-1, Py, source,.{
      .memcpy_params = lastMemcpyParams,
      .fft_params = lastFftParams,
      .N = n,
    });
  }
}


fn FFT_kernel(comptime width: u16, comptime n: u16, comptime tensor_type: type) void {
  const fp: i16 = if (tensor_type == f16) 0 else 1; // Precision: 0 == float16, 1 == float32
  // Validate parameters
  @comptime_assert(n >= 4, "FFT size N must be at least 4");
  @comptime_assert(n & (n-1) == 0, "FFT size N must be a power of 2");
  @comptime_assert(tensor_type == f16 or tensor_type == f32);
  @comptime_assert(width > 1, "Kernel width must be at least 2");
  @comptime_assert(width & (width-1) == 0, "Kernel width must be a power of 2");

  // first row
  FFT_row(0, 1, width, n, tensor_type);

  if (width > 2) {
    // second row
    FFT_row(1, 2, width, n, tensor_type);

    if (width > 4) {
      FFT_row(2, width-2, width, n, tensor_type);
    }
    // second to last row
    if (width > 3) {
      FFT_row(width-2, width-1, width, n, tensor_type);
    }
  }
  // last row
  FFT_row(width-1, width, width, n, tensor_type);

  @export_name("fft_time", [*]u16, true);
  @export_name("X", [*]tensor_type, true);
  @export_name("twiddle_array", [*]tensor_type, true);
  @export_name("csfftExecR2C", fn(i16)void);
  @export_name("csfftExecC2R", fn(i16)void);
  @export_name("csfftExecC2C", fn(i16,i16)void);
}
