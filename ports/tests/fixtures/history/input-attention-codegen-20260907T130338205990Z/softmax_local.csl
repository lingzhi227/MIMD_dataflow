// Reusable synchronous half softmax local stages; collective ownership stays with caller.
// Source-inspired by MeshInfra/WaferLLM fd1c2daae37cd68706c03fc8009887ecee9900f8, Apache-2.0.
param rows:i16;param cols:i16;
const math=@import_module("<math>");const dummy=@zeros([1]f16);
const full=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{rows*cols}->dummy[i]});
const column=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{rows}->dummy[i]});
const dest=@get_dsr(dsr_dest,1);const src0=@get_dsr(dsr_src0,1);const src1=@get_dsr(dsr_src1,1);
fn scale_max(values:[*]f16,peaks:[*]f16,scale:f16) void {
 const v=@set_dsd_base_addr(full,values);const vc=@set_dsd_base_addr(column,values);const p=@set_dsd_base_addr(column,peaks);
 @fmulh(v,v,scale);@fmovh(p,-65504.0);
 @load_to_dsr(dest,p,.{.save_address=false});@load_to_dsr(src0,p,.{.save_address=false});@load_to_dsr(src1,vc,.{.save_address=true});
 for(@range(i16,cols)) |i| {@fmaxh(dest,src0,src1);}
}
fn exp_value(v:f16) f16 {return math.exp_f16(v);}
fn shift_exp(values:[*]f16,peaks:[*]f16,exponents:[*]f16) void {
 const v=@set_dsd_base_addr(full,values);const vc=@set_dsd_base_addr(column,values);const p=@set_dsd_base_addr(column,peaks);const e=@set_dsd_base_addr(full,exponents);
 @load_to_dsr(dest,vc,.{.save_address=true});@load_to_dsr(src0,vc,.{.save_address=true});@load_to_dsr(src1,p,.{.save_address=false});
 for(@range(i16,cols)) |i| {@fsubh(dest,src0,src1);}
 @map(exp_value,v,e);
}
fn local_sum(exponents:[*]f16,sums:[*]f16) void {
 const e=@set_dsd_base_addr(column,exponents);const s=@set_dsd_base_addr(column,sums);@fmovh(s,0.0);
 @load_to_dsr(dest,s,.{.save_address=false});@load_to_dsr(src0,s,.{.save_address=false});@load_to_dsr(src1,e,.{.save_address=true});
 for(@range(i16,cols)) |i| {@faddh(dest,src0,src1);}
}
fn normalize(values:[*]f16,exponents:[*]f16,sums:[*]f16) void {
 for(@range(i16,rows)) |i| {sums[i]=1.0/sums[i];}
 const v=@set_dsd_base_addr(column,values);const e=@set_dsd_base_addr(column,exponents);const s=@set_dsd_base_addr(column,sums);
 @load_to_dsr(dest,v,.{.save_address=true});@load_to_dsr(src0,e,.{.save_address=true});@load_to_dsr(src1,s,.{.save_address=false});
 for(@range(i16,cols)) |i| {@fmulh(dest,src0,src1);}
}
