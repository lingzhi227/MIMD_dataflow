param P:i16;param B:i16;param Nt:i16;param groups:i16;param epsilon_bits:u16;param sampled:i16;param Ft:i16;param C:i16;
const memcpy=@import_module("<memcpy/get_params>",.{.width=P,.height=P});
layout {
 @set_rectangle(P,P);
 for(@range(i16,P)) |y| {for(@range(i16,P)) |x| {
  @set_tile_code(x,y,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.P=P,.B=B,.Nt=Nt,.groups=groups,.epsilon=@bitcast(f16,epsilon_bits),.sampled=sampled,.Ft=Ft,.C=C});
 }}
 @export_name("weights",[*]f16,true);@export_name("projections",[*]f16,true);@export_name("partial",[*]f16,true);
 @export_name("X",[*]f16,true);@export_name("W",[*]f16,true);@export_name("result",[*]f16,true);
 @export_name("sums",[*]f16,true);@export_name("history",[*]f16,true);
 @export_name("progress",[*]u16,true);@export_name("timing",[*]u16,true);@export_name("queues",[*]u16,true);
 @export_name("init_task",fn()void);@export_name("hls_main",fn()void);
}
