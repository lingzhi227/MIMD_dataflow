param P:i16;param B:i16;param Nt:i16;param St:i16;param score_block:i16;param value_block:i16;param output_block:i16;param scale_bits:u16;param sampled:i16;param epsilon_bits:u16;param q_block:i16;param k_block:i16;param v_block:i16;
const memcpy=@import_module("<memcpy/get_params>",.{.width=P,.height=P});
const c2d=@import_module("<collectives_2d/params>");
layout {
 @set_rectangle(P,P);
 for(@range(i16,P)) |y| {for(@range(i16,P)) |x| {
  @set_tile_code(x,y,"pe.csl",.{.memcpy_params=memcpy.get_params(x),
   .P=P,.B=B,.Nt=Nt,.St=St,.score_block=score_block,.value_block=value_block,.output_block=output_block,.scale_bits=scale_bits,.sampled=sampled,.epsilon_bits=epsilon_bits,.q_block=q_block,.k_block=k_block,.v_block=v_block,
   .c2d_params=c2d.get_params(@as(u16,x),@as(u16,y),.{
    .x_colors=.{@get_color(0),@get_color(1)},.x_entrypoints=.{@get_local_task_id(14),@get_local_task_id(15)},
    .y_colors=.{@get_color(4),@get_color(5)},.y_entrypoints=.{@get_local_task_id(16),@get_local_task_id(17)}
   })});
 }}
 @export_name("gamma",[*]f16,true);
