var x_ptr:[*]f16=&x;
var up_weight_ptr:[*]f16=&u;
var gate_weight_ptr:[*]f16=&g;
var down_weight_ptr:[*]f16=&d;
var result_ptr:[*]f16=&xwork;
var up_history_ptr:[*]f16=&up_history;
var gate_history_ptr:[*]f16=&gate_history;
var down_history_ptr:[*]f16=&down_history;
var gate_snapshot_ptr:[*]f16=&gate_snapshot;
var hidden_snapshot_ptr:[*]f16=&hidden_snapshot;
var activated_gate_ptr:[*]f16=&activated_gate;
var left_first_ptr:[*]f16=&left_first;
var right_first_ptr:[*]f16=&right_first;
var progress_ptr:[*]u16=&progress;
var timing_ptr:[*]u16=&timing;
var queues_ptr:[*]u16=&queues;
comptime {
@export_symbol(x_ptr,"x");
@export_symbol(up_weight_ptr,"up_weight");
@export_symbol(gate_weight_ptr,"gate_weight");
@export_symbol(down_weight_ptr,"down_weight");
@export_symbol(result_ptr,"result");
@export_symbol(up_history_ptr,"up_history");
@export_symbol(gate_history_ptr,"gate_history");
@export_symbol(down_history_ptr,"down_history");
@export_symbol(gate_snapshot_ptr,"gate_snapshot");
@export_symbol(hidden_snapshot_ptr,"hidden_snapshot");
@export_symbol(activated_gate_ptr,"activated_gate");
@export_symbol(left_first_ptr,"left_first");
@export_symbol(right_first_ptr,"right_first");
@export_symbol(progress_ptr,"progress");
@export_symbol(timing_ptr,"timing");
@export_symbol(queues_ptr,"queues");
@bind_local_task(left_matrix_finish,left_matrix_finish_id);@block(left_matrix_finish_id);
@bind_local_task(right_matrix_finish,right_matrix_finish_id);@block(right_matrix_finish_id);
@bind_local_task(two_hop_comm_finish,two_hop_comm_finish_id);@block(two_hop_comm_finish_id);
@bind_local_task(next_step,next_step_id);@block(next_step_id);
@export_symbol(init_task);@export_symbol(hls_main);}

const block_accum=@import_module("block_accumulate.csl",.{.length=L});
var wide_ptr:[*]u32=block_accum.words;
comptime {@export_symbol(wide_ptr,"wide_accumulator");}

const hidden_accum=@import_module("block_accumulate.csl",.{.length=H});
const hidden_words_dsd=@get_dsd(mem1d_dsd,.{.base_address=hidden_accum.words,.extent=@as(u16,H)});

var up_words=@zeros([H]u32);
const up_words_dsd=@get_dsd(mem1d_dsd,.{.tensor_access=|j|{H}->up_words[j]});
var up_words_ptr:[*]u32=&up_words;
comptime {@export_symbol(up_words_ptr,"up_accumulator");}

var gate_words=@zeros([H]u32);
const gate_words_dsd=@get_dsd(mem1d_dsd,.{.tensor_access=|j|{H}->gate_words[j]});
var gate_words_ptr:[*]u32=&gate_words;
comptime {@export_symbol(gate_words_ptr,"gate_accumulator");}

const rms_local=@import_module("rms_local.csl",.{.rows=seq_len_p_pe,.features=dim_p_pe,.global_features=dim_p_pe*P,.epsilon=@bitcast(f16,@as(u16,17))});
var gamma=@zeros([dim_p_pe]f16);var rms_rows=@zeros([seq_len_p_pe]f16);
var normalized_snapshot=@zeros([L]f16);var down_snapshot=@zeros([L]f16);var rms_progress=@zeros([2]u16);
var gamma_ptr:[*]f16=&gamma;var normalized_ptr:[*]f16=&normalized_snapshot;var down_snapshot_ptr:[*]f16=&down_snapshot;var rms_progress_ptr:[*]u16=&rms_progress;
comptime {@export_symbol(gamma_ptr,"gamma");@export_symbol(normalized_ptr,"normalized");@export_symbol(down_snapshot_ptr,"down_snapshot");@export_symbol(rms_progress_ptr,"rms_progress");}

const OW:i16=dim_p_pe*dim_p_pe;
var output_weight=@zeros([OW]f16);var residual=@zeros([L]f16);var post_projection_z=@zeros([L]f16);
var projection_snapshot=@zeros([L]f16);
var projection_history=@zeros([if(sampled!=0) P*L else 1]f16);
var projection_left_first=@zeros([if(sampled!=0) L else 1]f16);
var projection_right_first=@zeros([if(sampled!=0) OW else 1]f16);
var prelude_progress=@zeros([4]u16);
const o_view=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{OW}->output_weight[i]});
const residual_view=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{L}->residual[i]});
