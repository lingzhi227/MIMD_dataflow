 }

 if(phase==3){
  if(sampled!=0){
   @fmovh(@increment_dsd_offset(projection_history_view,step*L,f16),z_view);
   if(step==0){
    @fmovh(projection_left_view,@set_dsd_base_addr(lv,ptr_left_matrix_send));
    @fmovh(projection_right_view,@set_dsd_length(@set_dsd_base_addr(wv,ptr_right_matrix_send),@as(u16,OW)));
   }
  }
  return;
 }

 if(sampled!=0){
  const olen:i16=Mt*Nt;const llen:i16=Mt*Kt;
  var hptr:[*]f16=&down_history;if(phase==0){hptr=&up_history;}else if(phase==1){hptr=&gate_history;}
  const od=@set_dsd_length(@set_dsd_base_addr(hv,ptr_out_matrix),@as(u16,olen));
  const dst=@set_dsd_length(@set_dsd_base_addr(hv,hptr),@as(u16,olen));
  @fmovh(@increment_dsd_offset(dst,step*olen,f16),od);
  if(step==0){
   const ldst=@set_dsd_length(@set_dsd_base_addr(hv,@ptrcast([*]f16,&left_first)),@as(u16,llen));
   const lsrc=@set_dsd_length(@set_dsd_base_addr(hv,ptr_left_matrix_send),@as(u16,llen));
   @fmovh(@increment_dsd_offset(ldst,phase*L,f16),lsrc);
   @fmovh(@increment_dsd_offset(@set_dsd_base_addr(wv,@ptrcast([*]f16,&right_first)),phase*W,f16),@set_dsd_base_addr(wv,ptr_right_matrix_send));
  }
 }
}
fn matmul_compute() void {
 swap_ptr=ptr_left_matrix_send;ptr_left_matrix_send=ptr_left_matrix_recv;ptr_left_matrix_recv=swap_ptr;
 swap_ptr=ptr_right_matrix_send;ptr_right_matrix_send=ptr_right_matrix_recv;ptr_right_matrix_recv=swap_ptr;
 if(step<P){if(phase==0 or phase==1){@fmovh(@set_dsd_length(@set_dsd_base_addr(hv,ptr_out_matrix),@as(u16,Mt*Nt)),0.0);}
  if(phase==2){@fmovh(@set_dsd_base_addr(lv,ptr_out_matrix),0.0);}
  comm_mod.mm_two_hop_comm(ptr_left_matrix_send,ptr_right_matrix_send,ptr_left_matrix_recv,ptr_right_matrix_recv,step,Mt,Kt,Nt);
  left_matrix_dsd=@set_dsd_base_addr(left_matrix_dsd,ptr_left_matrix_send);right_matrix_dsd=@set_dsd_base_addr(right_matrix_dsd,ptr_right_matrix_send);
  for(@range(i16,Kt)) |k| {
   out_matrix_dsd=@set_dsd_base_addr(out_matrix_dsd,ptr_out_matrix);
   @load_to_dsr(comp_dest_dsr_1,out_matrix_dsd,.{.save_address=true});@load_to_dsr(comp_src0_dsr_1,out_matrix_dsd,.{.save_address=true});@load_to_dsr(comp_src1_dsr_1,left_matrix_dsd,.{.save_address=false});@map(matmul_map_func,right_matrix_dsd);
   left_matrix_dsd=@increment_dsd_offset(left_matrix_dsd,Mt,f16);if(phase==4){right_matrix_dsd=@increment_dsd_offset(right_matrix_dsd,1,f16);}else{right_matrix_dsd=@increment_dsd_offset(right_matrix_dsd,Nt,f16);}
  }
