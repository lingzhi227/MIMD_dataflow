fn matmul_map_func(curR:f16) void {@fmach(comp_dest_dsr_1,comp_src0_dsr_1,comp_src1_dsr_1,curR);}
fn left_matrix_shift_callback() void {
 if(pre_remaining>0){pre_remaining-=1;swap_ptr=ptr_left_matrix_send;ptr_left_matrix_send=ptr_left_matrix_recv;ptr_left_matrix_recv=swap_ptr;comm_mod.left_matrix_shift(ptr_left_matrix_send,ptr_left_matrix_recv,left_dim_length,shift_round);shift_round+=1;}
 else {in_preshift=false;if(phase>=6){input_prefix_progress[1]=@as(u16,shift_round);}else{if(phase==4){attention_progress[1]=@as(u16,shift_round);}else{if(phase==3){prelude_progress[0]=@as(u16,shift_round);}else{if(phase==0){progress[0]=@as(u16,shift_round);}else{progress[1]=@as(u16,shift_round);}}}}step=0;matmul_compute();}
}
fn observe() void {
 if(phase>=6){
  if(sampled!=0){
   const branch:i16=phase-6;
   @fmovh(@increment_dsd_offset(input_projection_history_view,(branch*P+step)*L,f16),@set_dsd_base_addr(lv,ptr_out_matrix));
   if(step==0){
    @fmovh(@increment_dsd_offset(input_left_first_view,branch*L,f16),@set_dsd_base_addr(lv,ptr_left_matrix_send));
    @fmovh(@increment_dsd_offset(input_right_first_view,branch*OW,f16),@set_dsd_base_addr(q_weight_view,ptr_right_matrix_send));
   }
  }
  return;
 }

 if(phase==4){
  if(sampled!=0){
   @fmovh(@increment_dsd_offset(attention_value_history_view,step*L,f16),z_view);
   @fmovh(@increment_dsd_offset(attention_value_left_view,step*S,f16),@set_dsd_base_addr(attention_score_view,ptr_left_matrix_send));
   @fmovh(@increment_dsd_offset(attention_value_right_view,step*L,f16),@set_dsd_base_addr(lv,ptr_right_matrix_send));
