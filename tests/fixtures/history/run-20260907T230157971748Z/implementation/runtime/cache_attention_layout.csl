param P:i16;param B:i16;param Nt:i16;param St:i16;param score_block:i16;param value_block:i16;param output_block:i16;param scale_bits:u16;param sampled:i16;
const memcpy=@import_module("<memcpy/get_params>",.{.width=P,.height=P});
const c2d=@import_module("<collectives_2d/params>");
layout {
 @set_rectangle(P,P);
 for(@range(i16,P)) |y| {for(@range(i16,P)) |x| {
  @set_tile_code(x,y,"pe.csl",.{.memcpy_params=memcpy.get_params(x),
   .P=P,.B=B,.Nt=Nt,.St=St,.score_block=score_block,.value_block=value_block,.output_block=output_block,.scale_bits=scale_bits,.sampled=sampled,
   .c2d_params=c2d.get_params(@as(u16,x),@as(u16,y),.{
    .x_colors=.{@get_color(0),@get_color(1)},.x_entrypoints=.{@get_local_task_id(14),@get_local_task_id(15)},
    .y_colors=.{@get_color(4),@get_color(5)},.y_entrypoints=.{@get_local_task_id(16),@get_local_task_id(17)}
   })});
 }}
 @export_name("X",[*]f16,true);
 @export_name("Q",[*]f16,true);
 @export_name("K",[*]f16,true);
 @export_name("V",[*]f16,true);
 @export_name("W",[*]f16,true);
 @export_name("score",[*]f16,true);
 @export_name("scaled",[*]f16,true);
 @export_name("exponents",[*]f16,true);
 @export_name("probability",[*]f16,true);
 @export_name("local_max",[*]f16,true);
 @export_name("maximum",[*]f16,true);
 @export_name("local_sum",[*]f16,true);
 @export_name("sums",[*]f16,true);
 @export_name("context",[*]f16,true);
 @export_name("delta",[*]f16,true);
 @export_name("result",[*]f16,true);
 @export_name("score_partial",[*]f16,true);
 @export_name("context_partial",[*]f16,true);
 @export_name("delta_partial",[*]f16,true);
 @export_name("progress",[*]u16,true);
 @export_name("timing",[*]u16,true);
 @export_name("queues",[*]u16,true);
 @export_name("init_task",fn()void);@export_name("hls_main",fn()void);
}
