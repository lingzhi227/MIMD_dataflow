// Derived from WaferLLM Prefill fd1c2daae37cd68706c03fc8009887ecee9900f8,
// Apache-2.0. Descriptor input and row-vector inverse scaling are explicit.
// Synchronous local stages only. Caller joins prior asynchronous compute and
// communication before entry, and performs row allreduce between square_sum
// and inverse. No colors, queues, tasks or microthreads are allocated here.
// Explicit DSR leases: dest/src0/src1 bank 1 and bank 2, only during each call.
param rows:i16;
param features:i16;
param global_features:i16;
param epsilon:f16;
comptime {
 @comptime_assert(rows>0 and features>0 and global_features>=features and global_features<=2048);
 @comptime_assert(@as(i32,rows)*@as(i32,features)<=32767);
 @comptime_assert(epsilon>0.0 and epsilon<=1.0);
}
const length:i16=rows*features;
const math=@import_module("<math>");
const d1=@get_dsr(dsr_dest,1);const a1=@get_dsr(dsr_src0,1);const b1=@get_dsr(dsr_src1,1);
const d2=@get_dsr(dsr_dest,2);const a2=@get_dsr(dsr_src0,2);const b2=@get_dsr(dsr_src1,2);

fn square_sum(input:[*]f16,scratch:[*]f16,sums:[*]f16) void {
 const xd=@get_dsd(mem1d_dsd,.{.base_address=input,.extent=@as(u16,length)});
 const sd=@get_dsd(mem1d_dsd,.{.base_address=scratch,.extent=@as(u16,length)});
 const sumd=@get_dsd(mem1d_dsd,.{.base_address=sums,.extent=@as(u16,rows)});
 const cold=@get_dsd(mem1d_dsd,.{.base_address=scratch,.extent=@as(u16,rows)});
 @load_to_dsr(d1,sd);@load_to_dsr(a1,xd);@load_to_dsr(b1,xd);@fmulh(d1,a1,b1);
 @load_to_dsr(d2,sumd,.{.save_address=false});@fmovh(d2,0.0);
 @load_to_dsr(a2,sumd,.{.save_address=false});@load_to_dsr(b2,cold,.{.save_address=true});
 for(@range(i16,features)) |j| {@faddh(d2,a2,b2);}
}

fn inverse(sums:[*]f16) void {
 for(@range(i16,rows)) |i| {
  const mean:f16=sums[i]/@as(f16,global_features);
  sums[i]=1.0/math.sqrt_f16(mean+epsilon);
 }
}

fn normalize(input:[*]f16,gamma:[*]f16,output:[*]f16,inverse_rows:[*]f16) void {
 const xd=@get_dsd(mem1d_dsd,.{.base_address=input,.extent=@as(u16,rows)});
 const yd=@get_dsd(mem1d_dsd,.{.base_address=output,.extent=@as(u16,rows)});
 const rd=@get_dsd(mem1d_dsd,.{.base_address=inverse_rows,.extent=@as(u16,rows)});
 @load_to_dsr(d1,yd,.{.save_address=true});@load_to_dsr(a1,xd,.{.save_address=true});
 for(@range(i16,features)) |j| {@fmulh(d1,a1,gamma[j]);}
 @load_to_dsr(d1,yd,.{.save_address=true});@load_to_dsr(a1,yd,.{.save_address=true});
 @load_to_dsr(b1,rd,.{.save_address=false});
 for(@range(i16,features)) |j| {@fmulh(d1,a1,b1);}
}
