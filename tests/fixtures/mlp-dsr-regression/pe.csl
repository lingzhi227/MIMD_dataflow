// Rectangular Prefill projection schedule, MeshInfra/WaferLLM fd1c2daa, Apache-2.0.
// Joined phase transitions preserve live left ownership and immutable host inputs.
param memcpy_params;param comm_params;param P:i16;param dim_p_pe:i16;param seq_len_p_pe:i16;param ffn_dim_p_pe:i16;param sampled:i16;
const L:i16=seq_len_p_pe*dim_p_pe;const H:i16=seq_len_p_pe*ffn_dim_p_pe;const W:i16=dim_p_pe*ffn_dim_p_pe;
const left_matrix_finish_id=@get_local_task_id(19);const right_matrix_finish_id=@get_local_task_id(20);const two_hop_comm_finish_id=@get_local_task_id(25);const next_step_id=@get_local_task_id(26);
const sys=@import_module("<memcpy/memcpy>",memcpy_params);const layout_mod=@import_module("<layout>");const time=@import_module("<time>");const config=@import_module("<tile_config>");
const comm_mod=@import_module("inference_comm.csl",.{.comm_params=comm_params,.P=P,.dim_p_pe=dim_p_pe,.seq_len_p_pe=seq_len_p_pe,.ffn_dim_p_pe=ffn_dim_p_pe,.left_matrix_finish_id=left_matrix_finish_id,.right_matrix_finish_id=right_matrix_finish_id});
const gating=@import_module("gated_local.csl",.{.length=H});
var x=@zeros([L]f16);var xwork=@zeros([L]f16);var xrecv=@zeros([L]f16);
var u=@zeros([W]f16);var g=@zeros([W]f16);var d=@zeros([W]f16);var ww=@zeros([W]f16);var wr=@zeros([W]f16);
var up=@zeros([H]f16);var gate=@zeros([H]f16);var hr=@zeros([H]f16);
const lv=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{L}->x[i]});const wv=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{W}->u[i]});const hv=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{H}->up[i]});
var up_history=@zeros([if(sampled!=0) P*H else 1]f16);var gate_history=@zeros([if(sampled!=0) P*H else 1]f16);var down_history=@zeros([if(sampled!=0) P*L else 1]f16);
var gate_snapshot=@zeros([if(sampled!=0) H else 1]f16);var hidden_snapshot=@zeros([if(sampled!=0) H else 1]f16);var activated_gate=@zeros([if(sampled!=0) H else 1]f16);
var left_first=@zeros([if(sampled!=0) 2*L+H else 1]f16);var right_first=@zeros([if(sampled!=0) 3*W else 1]f16);
var progress=@zeros([8]u16);var timing=@zeros([6]u16);var queues=@zeros([2]u16);var start=@zeros([3]u16);var end=@zeros([3]u16);
const dummy=@zeros([1]f16);
var left_matrix_dsd=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{1}->dummy[i]});var right_matrix_dsd=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{1}->dummy[i]});var out_matrix_dsd=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{1}->dummy[i]});
const comp_dest_dsr_1=@get_dsr(dsr_dest,1);const comp_src0_dsr_1=@get_dsr(dsr_src0,1);const comp_src1_dsr_1=@get_dsr(dsr_src1,1);
var ptr_left_matrix_send:[*]f16;var ptr_left_matrix_recv:[*]f16;var ptr_right_matrix_send:[*]f16;var ptr_right_matrix_recv:[*]f16;var ptr_out_matrix:[*]f16;var swap_ptr:[*]f16;
var Mt:i16=0;var Kt:i16=0;var Nt:i16=0;var step:i16=0;var phase:i16=0;var py:i16=0;var offset_step:i16=0;var in_preshift:bool=false;var pre_remaining:i16=0;var shift_round:i16=0;var left_dim_length:i16=0;
fn init_task() void {const px=@as(i16,layout_mod.get_x_coord());py=@as(i16,layout_mod.get_y_coord());offset_step=if(py==0) 0 else if(py%2==0) P-py/2 else (py+1)/2;comm_mod.init_(px,py);sys.unblock_cmd_stream();}
task left_matrix_finish() void {@block(left_matrix_finish_id);if(in_preshift){left_matrix_shift_callback();}else{@unblock(two_hop_comm_finish_id);}}
task right_matrix_finish() void {@block(right_matrix_finish_id);@activate(two_hop_comm_finish_id);}
task two_hop_comm_finish() void {@block(two_hop_comm_finish_id);@unblock(next_step_id);}
task next_step() void {@block(next_step_id);matmul_compute();}
fn matmul_map_func(curR:f16) void {@fmach(comp_dest_dsr_1,comp_src0_dsr_1,comp_src1_dsr_1,curR);}
fn left_matrix_shift_callback() void {
 if(pre_remaining>0){pre_remaining-=1;swap_ptr=ptr_left_matrix_send;ptr_left_matrix_send=ptr_left_matrix_recv;ptr_left_matrix_recv=swap_ptr;comm_mod.left_matrix_shift(ptr_left_matrix_send,ptr_left_matrix_recv,left_dim_length,shift_round);shift_round+=1;}
 else {in_preshift=false;if(phase==0){progress[0]=@as(u16,shift_round);}else{progress[1]=@as(u16,shift_round);}step=0;matmul_compute();}
}
fn observe() void {
 if(sampled!=0){
  const olen:i16=Mt*Nt;const llen:i16=Mt*Kt;
  var hptr:[*]f16=&down_history;if(phase==0){hptr=&up_history;}else if(phase==1){hptr=&gate_history;}
  const od=@set_dsd_length(@set_dsd_base_addr(hv,ptr_out_matrix),@as(u16,olen));
  const dst=@set_dsd_length(@set_dsd_base_addr(hv,hptr),@as(u16,olen));
  @fmovh(@increment_dsd_offset(dst,step*olen,f16),od);
  if(step==0){
   const ldst=@set_dsd_length(@set_dsd_base_addr(hv,@ptrcast([*]f16,&left_first)),@as(u16,llen));
   const lsrc=@set_dsd_length(@set_dsd_base_addr(hv,ptr_left_matrix_send),@as(u16,llen));
   @fmovh(@increment_dsd_offset(ldst,phase*L,f16),lsrc);
   @fmovh(@increment_dsd_offset(@set_dsd_base_addr(wv,@ptrcast([*]f16,&right_first)),phase*W,f16),@set_dsd_base_addr(wv,ptr_right_matrix_send));
  }
 }
}
fn matmul_compute() void {
 swap_ptr=ptr_left_matrix_send;ptr_left_matrix_send=ptr_left_matrix_recv;ptr_left_matrix_recv=swap_ptr;
 swap_ptr=ptr_right_matrix_send;ptr_right_matrix_send=ptr_right_matrix_recv;ptr_right_matrix_recv=swap_ptr;
 if(step<P){
  comm_mod.mm_two_hop_comm(ptr_left_matrix_send,ptr_right_matrix_send,ptr_left_matrix_recv,ptr_right_matrix_recv,step,Mt,Kt,Nt);
  left_matrix_dsd=@set_dsd_base_addr(left_matrix_dsd,ptr_left_matrix_send);right_matrix_dsd=@set_dsd_base_addr(right_matrix_dsd,ptr_right_matrix_send);
  for(@range(i16,Kt)) |k| {
   out_matrix_dsd=@set_dsd_base_addr(out_matrix_dsd,ptr_out_matrix);
   @load_to_dsr(comp_dest_dsr_1,out_matrix_dsd,.{.save_address=true});@load_to_dsr(comp_src0_dsr_1,out_matrix_dsd,.{.save_address=true});@load_to_dsr(comp_src1_dsr_1,left_matrix_dsd,.{.save_address=false});@map(matmul_map_func,right_matrix_dsd);
   left_matrix_dsd=@increment_dsd_offset(left_matrix_dsd,Mt,f16);right_matrix_dsd=@increment_dsd_offset(right_matrix_dsd,Nt,f16);
  }
  observe();progress[2+phase]+=1;step+=1;@activate(next_step_id);
 }else{step=0;phase_finish();}
}
fn setup_projection() void {
 Mt=seq_len_p_pe;Kt=if(phase==2) ffn_dim_p_pe else dim_p_pe;Nt=if(phase==2) dim_p_pe else ffn_dim_p_pe;
 ptr_out_matrix=&xwork;if(phase==0){ptr_out_matrix=&up;}else if(phase==1){ptr_out_matrix=&gate;}
 @fmovh(@set_dsd_length(@set_dsd_base_addr(hv,ptr_out_matrix),@as(u16,Mt*Nt)),0.0);
 var wp:[*]f16=&d;if(phase==0){wp=&u;}else if(phase==1){wp=&g;}@fmovh(@set_dsd_base_addr(wv,@ptrcast([*]f16,&ww)),@set_dsd_base_addr(wv,wp));
 ptr_right_matrix_send=&wr;ptr_right_matrix_recv=&ww;
 left_matrix_dsd=@set_dsd_length(left_matrix_dsd,@as(u16,Mt));out_matrix_dsd=@set_dsd_length(out_matrix_dsd,@as(u16,Mt));
 // Reset stride/offset as well as extent at every stage entry.
 right_matrix_dsd=@get_dsd(mem1d_dsd,.{.tensor_access=|i|{1}->dummy[i]});right_matrix_dsd=@set_dsd_length(right_matrix_dsd,@as(u16,Nt));
 if(phase==1){swap_ptr=ptr_left_matrix_send;ptr_left_matrix_send=ptr_left_matrix_recv;ptr_left_matrix_recv=swap_ptr;matmul_compute();}
 else {if(phase==0){ptr_left_matrix_send=&xrecv;ptr_left_matrix_recv=&xwork;}else{ptr_left_matrix_send=&hr;ptr_left_matrix_recv=&up;}left_dim_length=Mt*Kt;in_preshift=true;pre_remaining=offset_step;shift_round=0;left_matrix_shift_callback();}
}
fn phase_finish() void {
 progress[7]+=1;
 if(phase==0){phase=1;setup_projection();return;}
 if(phase==1){
  if(sampled!=0){@fmovh(@set_dsd_base_addr(hv,@ptrcast([*]f16,&gate_snapshot)),@set_dsd_base_addr(hv,@ptrcast([*]f16,&gate)));}
  gating.apply(&up,&gate);progress[5]=1;
  if(sampled!=0){@fmovh(@set_dsd_base_addr(hv,@ptrcast([*]f16,&hidden_snapshot)),hv);@fmovh(@set_dsd_base_addr(hv,@ptrcast([*]f16,&activated_gate)),@set_dsd_base_addr(hv,@ptrcast([*]f16,&gate)));}
  phase=2;setup_projection();return;
 }
 progress[6]+=1;time.get_timestamp(&end);time.disable_tsc();for(@range(i16,3)) |i| {timing[i]=start[i];timing[i+3]=end[i];}
 const qi=config.input_queue_status.get();const qo=config.output_queue_status.get();queues[0]=@as(u16,qi.empty);queues[1]=@as(u16,qo.empty);sys.unblock_cmd_stream();
}
fn hls_main() void {time.enable_tsc();time.get_timestamp(&start);for(@range(i16,8)) |i| {if(i!=6){progress[i]=0;}}phase=0;step=0;@fmovh(@set_dsd_base_addr(lv,@ptrcast([*]f16,&xwork)),lv);setup_projection();}
var x_ptr:[*]f16=&x;
var up_weight_ptr:[*]f16=&u;
var gate_weight_ptr:[*]f16=&g;
var down_weight_ptr:[*]f16=&d;
var result_ptr:[*]f16=&xwork;
var up_history_ptr:[*]f16=&up_history;
var gate_history_ptr:[*]f16=&gate_history;
var down_history_ptr:[*]f16=&down_history;
var gate_snapshot_ptr:[*]f16=&gate_snapshot;
var hidden_snapshot_ptr:[*]f16=&hidden_snapshot;
var activated_gate_ptr:[*]f16=&activated_gate;
var left_first_ptr:[*]f16=&left_first;
var right_first_ptr:[*]f16=&right_first;
var progress_ptr:[*]u16=&progress;
var timing_ptr:[*]u16=&timing;
var queues_ptr:[*]u16=&queues;
comptime {
@export_symbol(x_ptr,"x");
@export_symbol(up_weight_ptr,"up_weight");
@export_symbol(gate_weight_ptr,"gate_weight");
@export_symbol(down_weight_ptr,"down_weight");
@export_symbol(result_ptr,"result");
@export_symbol(up_history_ptr,"up_history");
@export_symbol(gate_history_ptr,"gate_history");
@export_symbol(down_history_ptr,"down_history");
@export_symbol(gate_snapshot_ptr,"gate_snapshot");
@export_symbol(hidden_snapshot_ptr,"hidden_snapshot");
@export_symbol(activated_gate_ptr,"activated_gate");
@export_symbol(left_first_ptr,"left_first");
@export_symbol(right_first_ptr,"right_first");
@export_symbol(progress_ptr,"progress");
@export_symbol(timing_ptr,"timing");
@export_symbol(queues_ptr,"queues");
@bind_local_task(left_matrix_finish,left_matrix_finish_id);@block(left_matrix_finish_id);
@bind_local_task(right_matrix_finish,right_matrix_finish_id);@block(right_matrix_finish_id);
@bind_local_task(two_hop_comm_finish,two_hop_comm_finish_id);@block(two_hop_comm_finish_id);
@bind_local_task(next_step,next_step_id);@block(next_step_id);
@export_symbol(init_task);@export_symbol(hls_main);}
